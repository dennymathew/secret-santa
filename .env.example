# Public Firebase web config (Project settings → Your apps → Web app).
# Leave VITE_FIREBASE_API_KEY empty locally to use the fake dev sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set this to your site's own domain (e.g. berlinmallusanta.pages.dev) so Google sign-in
# goes through the /__/auth proxy. That keeps redirect sign-in working in Safari and in-app browsers.
VITE_FIREBASE_AUTH_DOMAIN=

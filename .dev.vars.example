# Local development only. Copy to .dev.vars (git-ignored).
# DEV_AUTH=1 enables a fake Google sign-in (type a name and email) and ONLY works on localhost.
DEV_AUTH=1
UNSEAL_QUORUM=2
# Any 32 random bytes, base64. Generate with: openssl rand -base64 32
MATCH_KEY=REPLACE_WITH_openssl_rand_-base64_32

# Admins are kept in the local database. Add one, then "Sign in as admin" with that email:
#   ./scripts/admins.sh add name@gmail.com --local
